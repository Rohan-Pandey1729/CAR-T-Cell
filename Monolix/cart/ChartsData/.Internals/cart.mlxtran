<DATAFILE>

[FILEINFO]
file={path='../../../cart_data_no_noise.csv'}
delimiter = comma
header={time, id, observation, observation_id, observation_type}

[CONTENT]
time = {use=time}
id = {use=identifier}
observation = {use=observation, yname={'0', '1', '2', '3'}, type={continuous, continuous, continuous, continuous}}
observation_id = {use=observationtype}

<MODEL>

[INDIVIDUAL]
input = {KA_pop, omega_KA, KN_pop, omega_KN, KP_pop, omega_KP, Kr_pop, omega_Kr, e_pop, omega_e, kA_pop, omega_kA, kb_pop, omega_kb, km_pop, omega_km, lTA_pop, omega_lTA, lTN_pop, omega_lTN, nC_pop, omega_nC, nN0_pop, omega_nN0, nP0_pop, omega_nP0, nTA0_pop, omega_nTA0, nTN0_pop, omega_nTN0, rN_pop, omega_rN, rP_pop, omega_rP, rTA_pop, omega_rTA}

DEFINITION:
KA = {distribution=logNormal, typical=KA_pop, sd=omega_KA}
KN = {distribution=logNormal, typical=KN_pop, sd=omega_KN}
KP = {distribution=logNormal, typical=KP_pop, sd=omega_KP}
Kr = {distribution=logNormal, typical=Kr_pop, sd=omega_Kr}
e = {distribution=logNormal, typical=e_pop, sd=omega_e}
kA = {distribution=logNormal, typical=kA_pop, sd=omega_kA}
kb = {distribution=logNormal, typical=kb_pop, sd=omega_kb}
km = {distribution=logNormal, typical=km_pop, sd=omega_km}
lTA = {distribution=logNormal, typical=lTA_pop, sd=omega_lTA}
lTN = {distribution=logNormal, typical=lTN_pop, sd=omega_lTN}
nC = {distribution=logNormal, typical=nC_pop, sd=omega_nC}
nN0 = {distribution=logNormal, typical=nN0_pop, sd=omega_nN0}
nP0 = {distribution=logNormal, typical=nP0_pop, sd=omega_nP0}
nTA0 = {distribution=logNormal, typical=nTA0_pop, sd=omega_nTA0}
nTN0 = {distribution=logNormal, typical=nTN0_pop, sd=omega_nTN0}
rN = {distribution=logNormal, typical=rN_pop, sd=omega_rN}
rP = {distribution=logNormal, typical=rP_pop, sd=omega_rP}
rTA = {distribution=logNormal, typical=rTA_pop, sd=omega_rTA}

[LONGITUDINAL]
input = {a0, a1, a2, a3}

file = '../../../model.txt'

DEFINITION:
y0 = {distribution=normal, prediction=nP, errorModel=constant(a0)}
y1 = {distribution=normal, prediction=nTA, errorModel=constant(a1)}
y2 = {distribution=normal, prediction=nTN, errorModel=constant(a2)}
y3 = {distribution=normal, prediction=nN, errorModel=constant(a3)}

<FIT>
data = {'0', '1', '2', '3'}
model = {y0, y1, y2, y3}

<PARAMETER>
KA_pop = {value=50, method=MLE}
KN_pop = {value=20000, method=MLE}
KP_pop = {value=50, method=MLE}
Kr_pop = {value=100, method=MLE}
a0 = {value=1, method=MLE}
a1 = {value=1, method=MLE}
a2 = {value=1, method=MLE}
a3 = {value=1, method=MLE}
e_pop = {value=20, method=MLE}
kA_pop = {value=0.5, method=MLE}
kb_pop = {value=8, method=MLE}
km_pop = {value=0.00000015, method=MLE}
lTA_pop = {value=0.1, method=MLE}
lTN_pop = {value=0.1, method=MLE}
nC_pop = {value=2000, method=MLE}
nN0_pop = {value=20, method=MLE}
nP0_pop = {value=2000, method=MLE}
nTA0_pop = {value=50, method=MLE}
nTN0_pop = {value=20, method=MLE}
omega_KA = {value=1, method=MLE}
omega_KN = {value=1, method=MLE}
omega_KP = {value=1, method=MLE}
omega_Kr = {value=1, method=MLE}
omega_e = {value=1, method=MLE}
omega_kA = {value=1, method=MLE}
omega_kb = {value=1, method=MLE}
omega_km = {value=1, method=MLE}
omega_lTA = {value=1, method=MLE}
omega_lTN = {value=1, method=MLE}
omega_nC = {value=1, method=MLE}
omega_nN0 = {value=1, method=MLE}
omega_nP0 = {value=1, method=MLE}
omega_nTA0 = {value=1, method=MLE}
omega_nTN0 = {value=1, method=MLE}
omega_rN = {value=1, method=MLE}
omega_rP = {value=1, method=MLE}
omega_rTA = {value=1, method=MLE}
rN_pop = {value=0.1, method=MLE}
rP_pop = {value=0.07, method=MLE}
rTA_pop = {value=1.6, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMean, conditionalMode })
fim(run = false,method = StochasticApproximation)
logLikelihood(run = false,method = ImportanceSampling)

[PLOTS]
run = true
plots = {indfits = {selected = true}, parameterdistribution = {selected = true}, obspred = {selected = true}, covariancemodeldiagnosis = {selected = true}, covariatemodeldiagnosis = {selected = true}, vpc = {selected = true}, residualsscatter = {selected = true}, residualsdistribution = {selected = true}, randomeffects = {selected = true}, saemresults = {selected = true}}

[SETTINGS]
GLOBAL:
exportpath = '../../'

