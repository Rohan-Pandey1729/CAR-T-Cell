<DATAFILE>

[FILEINFO]
file={path='../../../owens_bozic_perf.csv'}
delimiter = comma
header={time, id, observation, observation_id, observation_type}

[CONTENT]
time = {use=time}
id = {use=identifier}
observation = {use=observation, yname={'0', '1', '2', '3'}, type={continuous, continuous, continuous, continuous}}
observation_id = {use=observationtype}

<MODEL>

[INDIVIDUAL]
input = {a_pop, omega_a, b_pop, omega_b, dE_pop, omega_dE, dC_pop, omega_dC, g_pop, omega_g, jE_pop, omega_jE, jC_pop, omega_jC, K_pop, omega_K, k_pop, omega_k, l_pop, omega_l, mE_pop, omega_mE, mC_pop, omega_mC, qE_pop, omega_qE, qC_pop, omega_qC, s_pop, omega_s, KT_pop, omega_KT, KE_pop, omega_KE, KC_pop, omega_KC, gamma_pop, omega_gamma, T0_pop, omega_T0, E0_pop, omega_E0, C0_pop, omega_C0, M0_pop, omega_M0}

DEFINITION:
a = {distribution=logNormal, typical=a_pop, no-variability}
b = {distribution=logNormal, typical=b_pop, no-variability}
dE = {distribution=logNormal, typical=dE_pop, no-variability}
dC = {distribution=logNormal, typical=dC_pop, sd=omega_dC}
g = {distribution=logNormal, typical=g_pop, no-variability}
jE = {distribution=logNormal, typical=jE_pop, no-variability}
jC = {distribution=logNormal, typical=jC_pop, no-variability}
K = {distribution=logNormal, typical=K_pop, no-variability}
k = {distribution=logNormal, typical=k_pop, no-variability}
l = {distribution=logNormal, typical=l_pop, no-variability}
mE = {distribution=logNormal, typical=mE_pop, no-variability}
mC = {distribution=logNormal, typical=mC_pop, no-variability}
qE = {distribution=logNormal, typical=qE_pop, no-variability}
qC = {distribution=logNormal, typical=qC_pop, no-variability}
s = {distribution=logNormal, typical=s_pop, no-variability}
KT = {distribution=logNormal, typical=KT_pop, no-variability}
KE = {distribution=logNormal, typical=KE_pop, no-variability}
KC = {distribution=logNormal, typical=KC_pop, no-variability}
gamma = {distribution=logNormal, typical=gamma_pop, no-variability}
T0 = {distribution=logNormal, typical=T0_pop, no-variability}
E0 = {distribution=logNormal, typical=E0_pop, no-variability}
C0 = {distribution=logNormal, typical=C0_pop, no-variability}
M0 = {distribution=logNormal, typical=M0_pop, no-variability}

[LONGITUDINAL]
input = {b0, b1, b2, b3}

file = '../../../owens_bozic.txt'

DEFINITION:
y0 = {distribution=normal, prediction=TT, errorModel=proportional(b0)}
y1 = {distribution=normal, prediction=EEE, errorModel=proportional(b1)}
y2 = {distribution=normal, prediction=CCC, errorModel=proportional(b2)}
y3 = {distribution=normal, prediction=MM, errorModel=proportional(b3)}

<FIT>
data = {'0', '1', '2', '3'}
model = {y0, y1, y2, y3}

<PARAMETER>
C0_pop = {value=63000000, method=FIXED}
E0_pop = {value=400000, method=FIXED}
KC_pop = {value=0.6, method=FIXED}
KE_pop = {value=0.6, method=FIXED}
KT_pop = {value=0.7, method=FIXED}
K_pop = {value=521000000, method=FIXED}
M0_pop = {value=6, method=FIXED}
T0_pop = {value=1580000000, method=FIXED}
a_pop = {value=0.33, method=FIXED}
b0 = {value=0.1, method=MLE}
b1 = {value=0.1, method=MLE}
b2 = {value=0.1, method=MLE}
b3 = {value=0.1, method=MLE}
b_pop = {value=0.0000000000226, method=FIXED}
c0 = {value=1, method=FIXED}
c1 = {value=1, method=FIXED}
c2 = {value=1, method=FIXED}
c3 = {value=1, method=FIXED}
dC_pop = {value=2.25, method=MLE}
dE_pop = {value=3.17, method=FIXED}
g_pop = {value=10300, method=FIXED}
gamma_pop = {value=0.9, method=FIXED}
jC_pop = {value=0.346, method=FIXED}
jE_pop = {value=0.0156, method=FIXED}
k_pop = {value=8670000, method=FIXED}
l_pop = {value=1.418, method=FIXED}
mC_pop = {value=0.293, method=FIXED}
mE_pop = {value=0.0176, method=FIXED}
omega_dC = {value=0.01, method=MLE}
qC_pop = {value=0.000000000214, method=FIXED}
qE_pop = {value=0.000000000128, method=FIXED}
s_pop = {value=0.302, method=FIXED}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMean, conditionalMode })
fim(run = false,method = none )
logLikelihood(run = false,method = none )

[PLOTS]
run = false
plots = {indfits = {selected = true}, parameterdistribution = {selected = true}, obspred = {selected = true}, covariancemodeldiagnosis = {selected = true}, covariatemodeldiagnosis = {selected = true}, vpc = {selected = true}, residualsscatter = {selected = true}, residualsdistribution = {selected = true}, randomeffects = {selected = true}, saemresults = {selected = true}}

[SETTINGS]
GLOBAL:
seed = 545331266
exportpath = '../../'

